<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Sandbox is MANDATORY for all Mac App Store submissions -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Network client access for StoreKit receipt validation and API communication -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Read and write access to files selected by the user in Open/Save dialogs -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Application identifier for TestFlight and App Store eligibility -->
	<key>com.apple.application-identifier</key>
	<string>8J8MPH7HLU.com.clipmory.app</string>
	<key>com.apple.developer.team-identifier</key>
	<string>8J8MPH7HLU</string>
</dict>
</plist>
